# Copy this file to .env and fill only what you need.
# AI_PROVIDER picks which extractor the batch processor uses: openai, anthropic, openrouter, or gemini.
# Only the selected provider's key is required; the others can be left blank.
# The *_MODEL values below are placeholders, not verified-valid API model IDs. Before running a
# real batch, confirm (or change) the active one via the dashboard's "View models for active
# provider" button -- a wrong model name fails every item in the queue the same way.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_PROMPT_VERSION=collector_v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_PROMPT_VERSION=collector_v1

# OpenRouter uses its own OpenAI-compatible endpoint, so no extra SDK dependency is needed.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_PROMPT_VERSION=collector_v1

# Gemini uses Google's OpenAI-compatible endpoint, so no extra SDK dependency is needed.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_PROMPT_VERSION=collector_v1
HOST=127.0.0.1
PORT=8765
OPERATOR_TIMEZONE=Asia/Kuala_Lumpur
SCREENSHOT_RETENTION=review_only
MAX_PRODUCT_IMAGES=12
MAX_IMAGE_BYTES=12582912
IMAGE_MIN_WIDTH=160
IMAGE_MIN_HEIGHT=160
MAX_IMAGE_PIXELS=40000000
REQUEST_TIMEOUT_SECONDS=45
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_SECONDS=1
AI_RETRY_MAX_SECONDS=8
GUARDIANLENS_MODE=production
